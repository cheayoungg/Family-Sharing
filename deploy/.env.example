# ------------------------------------------------------------------
# 운영 서버의 deploy/docker-compose.yml이 읽는 환경변수
#
# 사용법: 이 파일을 같은 폴더에 .env로 복사해 값을 채운다 (cp .env.example .env && chmod 600 .env)
# .env는 비밀값이 들어가므로 커밋하지 않는다 (.gitignore 대상).
#
# 필수 값은 비워 두었다. 비어 있으면 docker compose가 실행 전에 어떤 변수가 빠졌는지 알려 주고 멈춘다.
# 값에 따옴표는 붙이지 않는다.
# ------------------------------------------------------------------

# ===== 이미지 (필수) =====
# 이미지를 올린 레지스트리. 예: ghcr.io/<계정>, <계정 ID>.dkr.ecr.ap-northeast-2.amazonaws.com
IMAGE_REGISTRY=
# 배포할 이미지 태그 (커밋 해시 등). 되돌릴 때는 이전 태그로 바꾸고 docker compose up -d
IMAGE_TAG=

# ===== 데이터베이스 (필수) =====
# db 컨테이너를 처음 만들 때 이 이름·계정으로 DB를 만들고, app도 같은 값으로 접속한다
DB_NAME=
DB_USERNAME=
# 생성 예: openssl rand -base64 24
DB_PASSWORD=

# ===== HTTPS (필수, HTTPS.md 참고) =====
# 인증서를 받을 도메인. DNS A 레코드가 이 서버의 공인 IP를 가리켜야 한다. 예: api.example.com
DOMAIN=
# Let's Encrypt 계정 연락처 이메일 (Let's Encrypt는 2025년부터 만료 안내 메일을 보내지 않으므로 만료 확인은 HTTPS.md 5단계 참고)
CERTBOT_EMAIL=

# ===== 앱 (필수) =====
# JWT 서명 키. 32바이트 이상의 무작위 문자열. 한 번 정하면 바꾸지 않는다 (바꾸면 모든 사용자가 다시 로그인)
# 생성 예: openssl rand -base64 48
JWT_SECRET=
# 요청을 허용할 프론트엔드 origin. 여러 개면 쉼표로 구분, 공백 없이. 예: https://family.example.com
CORS_ALLOWED_ORIGINS=

# ===== 메모리 (선택, 비우면 기본값) =====
# app 컨테이너 메모리 제한. 1GB 서버: 768m(기본값), 2GB 서버: 1536m
APP_MEM_LIMIT=
# heap 상한 = 메모리 제한의 몇 %. 1GB 서버: 50(기본값), 2GB 서버: 75까지
APP_HEAP_PERCENT=

# ===== 특수 상황 (선택, 비우면 false) =====
# Flyway 도입 전에 만든 DB를 이어 쓸 때만 한 번 true로 실행하고, 기록이 생기면 다시 비운다 (README 배포 4단계)
FLYWAY_BASELINE_ON_MIGRATE=
