# ------------------------------------------------------------------
# Docker로 실행할 때 필요한 환경변수 (dev / prod 프로필)
#
# 사용법: 이 파일을 .env로 복사해 값을 채운 뒤
#   docker run --env-file .env ...
# 또는 앱과 DB를 함께 띄울 때 (docker-compose.yml이 .env를 읽는다)
#   docker compose up -d --build
#
# .env는 비밀값이 들어가므로 커밋하지 않는다 (.gitignore 대상).
# docker --env-file은 따옴표를 값의 일부로 읽으므로 값에 따옴표를 붙이지 않는다.
# 로컬에서 ./gradlew bootRun으로 실행할 때는 이 파일이 필요 없다 (README 참고).
# ------------------------------------------------------------------

# 실행 프로필: prod 또는 dev (이미지 기본값은 prod, docker compose는 이 값이 없으면 dev)
#   prod: Flyway 마이그레이션(db/migration)으로 테이블 생성·변경, ddl-auto=validate로 엔티티와 대조, Swagger 꺼짐
#   dev : Flyway 없이 ddl-auto=update로 테이블 자동 생성·변경, Swagger 켜짐
# dev로 만든 DB를 prod로 띄우면 Flyway 이력이 없어 시작에 실패한다. 운영 DB는 처음부터 prod로 만든다
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL 접속 정보
# 같은 Docker 네트워크의 DB 컨테이너라면 호스트에 컨테이너 이름을 쓴다 (예: jdbc:postgresql://homeproject-db:5432/homeproject)
# docker compose로 띄우면 DB_URL은 compose 안의 DB로 덮어쓰고, DB_USERNAME/DB_PASSWORD는 DB 컨테이너 계정으로도 쓴다
DB_URL=jdbc:postgresql://db.example.com:5432/homeproject
DB_USERNAME=homeproject
# 비워 두면 compose의 DB 컨테이너가 시작되지 않는다. 생성 예: openssl rand -base64 24
DB_PASSWORD=

# JWT 서명 키. 32바이트(영문 32자) 이상의 무작위 문자열. 환경마다 따로 만든다
# 비워 두거나 32바이트보다 짧으면 앱이 시작 단계에서 실패한다
# 생성 예: openssl rand -base64 48
JWT_SECRET=

# 요청을 허용할 프론트엔드 origin. 여러 개면 쉼표로 구분, 공백 없이
# 예: https://family.example.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=
